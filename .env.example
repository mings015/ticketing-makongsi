# Database
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token
REFRESH_TOKEN_EXPIRES_DAYS=7

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Cookie
COOKIE_SECRET=change-me-to-a-long-random-cookie-secret-32-chars
